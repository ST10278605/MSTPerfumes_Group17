<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit Support Inquiry"
            android:textColor="#512DA8"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Our support team and automated assistant will respond promptly."
            android:textColor="#666666"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etTicketName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Your Full Name"
            android:inputType="textPersonName"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etTicketEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Your Email Address"
            android:inputType="textEmailAddress"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Inquiry Category:"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spTicketCategory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/etTicketSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Inquiry Subject (e.g. Order Tracking)"
            android:inputType="text"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etTicketMessage"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="10dp"
            android:gravity="top|start"
            android:hint="Describe your issue or question in detail..."
            android:inputType="textMultiLine"
            android:padding="12dp" />

    </LinearLayout>

</ScrollView>
