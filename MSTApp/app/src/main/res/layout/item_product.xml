<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Full-Bleed Product Image Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="150dp">

            <ImageView
                android:id="@+id/ivProductImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bleu_de_chanel_eau_de_parfum_for_men" />

            <!-- New Pill Badge (Top Left) -->
            <TextView
                android:id="@+id/tvNewBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/bg_badge_new"
                android:text="New"
                android:textColor="#111111"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Wishlist Button (Top Right) -->
            <ImageButton
                android:id="@+id/btnWishlist"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_wishlist_circle"
                android:contentDescription="Wishlist Toggle"
                android:padding="5dp"
                android:src="@android:drawable/btn_star_big_off" />



        </FrameLayout>

        <!-- Bottom Content (Centered Alignment) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <!-- Product Title (Centered) -->
            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="Product Name"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Retail Price (Centered) -->
            <TextView
                android:id="@+id/tvRetailPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="R 485.00"
                android:textColor="#555555"
                android:textSize="13sp" />

            <!-- Bulk Price (Centered) -->
            <TextView
                android:id="@+id/tvBulkPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center"
                android:text="Bulk: R 225.00"
                android:textColor="@color/golden_sand"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Rating & Reviews (Centered) -->
            <TextView
                android:id="@+id/tvReviews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:text="4 reviews ★"
                android:textColor="#777777"
                android:textSize="11sp" />

            <!-- Scent Profile -->
            <TextView
                android:id="@+id/tvScentProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="Aromatic &amp; Woody Notes"
                android:textColor="#888888"
                android:textSize="10sp"
                android:textStyle="italic" />

            <!-- Add to Cart Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddToCart"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/deep_burgundy"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="0dp"
                android:paddingVertical="0dp"
                android:text="Add to Cart"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                app:cornerRadius="17dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>